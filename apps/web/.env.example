# Sans ces variables, l'app tourne en MODE DÉMO (données d'exemple, aucune connexion).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Affiche le bouton « Continuer avec Google » sur /signup et /login (1 = oui). À mettre à 1 une fois Google activé dans
# Supabase > Authentication > Sign In / Providers > Google (Client ID et Client Secret de la console Google Cloud, saisis dans
# Supabase : ils ne vont PAS dans ce fichier). Retours à déclarer :
#   - Google Cloud > Identifiants > URI de redirection autorisées : https://<réf-du-projet>.supabase.co/auth/v1/callback
#   - Supabase > Authentication > URL Configuration : Site URL = NEXT_PUBLIC_SITE_URL ; Redirect URLs = <NEXT_PUBLIC_SITE_URL>/**
# Sans projet Supabase (mode démo), le bouton s'affiche quand même et explique que la connexion est désactivée.
NEXT_PUBLIC_AUTH_GOOGLE=0
# URL publique du site (liens des emails de confirmation) = domaine principal
NEXT_PUBLIC_SITE_URL=http://localhost:3100
# Domaines secondaires qui redirigent (308) vers le domaine principal ci-dessus, avec leur www., chemin conservé.
# Absent : getpostbiz.com, trypostiz.com, postizz.com, post-iz.com. Vide : aucun. Sans effet tant que le site est en local.
# Lues au build : à définir avant `next build`. Chaque domaine doit aussi pointer vers l'hébergement (DNS + certificat).
# SITE_ALIAS_DOMAINS=getpostbiz.com,trypostiz.com,postizz.com,post-iz.com
# Pages légales (/cgu, /confidentialite, /suppression-des-donnees, /contact), exigées par TikTok, Google et Meta pour valider l'application.
# NEXT_PUBLIC_CONTACT_EMAIL : adresse affichée comme contact (défaut contact@getpostbiz.com : la boîte doit exister).
# NEXT_PUBLIC_LEGAL_ENTITY : qui exploite le service, en une ligne (raison sociale, forme juridique, adresse, immatriculation).
# Lues au build : à définir avant `next build` (et dans Vercel).
# NEXT_PUBLIC_CONTACT_EMAIL=contact@getpostbiz.com
# NEXT_PUBLIC_LEGAL_ENTITY=Ma Société SAS, 1 rue Exemple, 75000 Paris, SIREN 000 000 000

# --- Connexion des canaux par OAuth (côté serveur uniquement : jamais de préfixe NEXT_PUBLIC_) ---
# Même valeurs que dans le .env racine. NEXT_PUBLIC_SITE_URL doit être l'adresse publique exacte : elle sert
# d'adresse de retour OAuth et de contrôle d'origine du bouton « Connecter ».
SUPABASE_SERVICE_ROLE_KEY=
TOKEN_ENCRYPTION_KEY=
META_APP_ID=
META_APP_SECRET=
# Application Meta « Facebook Login for Business » (cas d'utilisation « Tout gérer sur votre Page ») : ID de la configuration de connexion créée chez Meta
# (Facebook Login for Business > Configurations, type « jeton d'accès utilisateur », avec les permissions de docs/RESEAUX.md). Vide : connexion classique par permissions.
META_LOGIN_CONFIG_ID=
# Instagram Standalone (connexion « Instagram Login », sans Page Facebook) : identifiants Instagram de l'application Meta (cas d'utilisation « Gérer les messages et
# les contenus sur Instagram », rubrique « Configuration de l'API avec la connexion Instagram »). Distincts de META_APP_ID / META_APP_SECRET.
# Adresse de retour à y déclarer : <site>/api/oauth/callback/instagram_login. Vides : le bouton « Instagram Standalone » reste désactivé.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Pages LinkedIn : une SECONDE application chez LinkedIn, car la Community Management API doit être le seul produit de son application.
# Adresse de retour à y déclarer : <site>/api/oauth/callback/linkedin_page. Vide : le bouton « LinkedIn Page » reste désactivé.
LINKEDIN_PAGE_CLIENT_ID=
LINKEDIN_PAGE_CLIENT_SECRET=
# Google ici = connecter une chaîne YouTube (retour <site>/api/oauth/callback/google). Rien à voir avec la connexion à
# Postbiz avec Google, réglée dans Supabase (voir NEXT_PUBLIC_AUTH_GOOGLE plus haut) : deux clients OAuth distincts.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Visibilité des vidéos envoyées sur YouTube (lue par le worker) : private (défaut), unlisted ou public. Garder « private » tant que l'audit de l'API YouTube n'est pas passé.
YOUTUBE_PRIVACY=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- Assistant IA du composeur (rédiger, améliorer, idées d'après l'actualité et la base de connaissance) ---
# Même modèle que les assistants de texte de Postiz : GPT-4.1, d'OpenAI. La clé d'API est celle de l'Agent, plus bas (OPENAI_API_KEY).
# Sans clé, le panneau « Assistant IA » s'affiche mais explique qu'il n'est pas activé. L'usage est facturé par OpenAI : chaque utilisateur est limité en nombre de demandes.
# Modèle de l'assistant (facultatif). Défaut : gpt-4.1.
# OPENAI_ASSISTANT_MODEL=gpt-4.1

# --- Page « Agent » (web) et Agent du mobile : même agent, même modèle que celui de Postiz (GPT-5.2, d'OpenAI) ---
# Clé d'API OpenAI (platform.openai.com) : la même variable que Postiz, utilisée aussi par l'assistant du composeur ci-dessus.
# Côté serveur uniquement : jamais de préfixe NEXT_PUBLIC_.
# Sans elle, l'Agent s'affiche mais explique qu'il n'est pas disponible. Jusqu'à 4 appels au modèle par message, 20 messages par utilisateur et par 10 minutes.
OPENAI_API_KEY=
# Modèle de l'agent (facultatif). Défaut : gpt-5.2, comme Postiz.
# OPENAI_AGENT_MODEL=gpt-5.2

# --- Images et vidéos générées par l'Agent (web et mobile), comme dans Postiz ---
# Images : le modèle d'images de Postiz (chatgpt-image-latest, d'OpenAI), avec la même clé OPENAI_API_KEY. Chaque image est facturée par OpenAI.
# OPENAI_IMAGE_MODEL=chatgpt-image-latest
# Qualité (low | medium | high | auto). Défaut : medium (Postiz laisse « auto ») : une image « high » peut dépasser les 60 secondes d'une réponse de l'agent.
# OPENAI_IMAGE_QUALITY=medium
# Vidéos : Seedance 2.0 (8 secondes, 720p, avec son) par Evolink (evolink.ai), comme Postiz : la même variable. Sans clé, l'Agent ne propose pas de vidéo.
# Côté serveur uniquement. Une vidéo prend plusieurs minutes : elle est enregistrée dans la médiathèque quand le navigateur ou le mobile l'interroge et qu'elle est prête.
EVOLINK_API_KEY=
# Plafonds par organisation et par jour glissant (0 désactive la génération). Défauts : 30 images, 5 vidéos.
# AGENT_IMAGES_PER_DAY=30
# AGENT_VIDEOS_PER_DAY=5
