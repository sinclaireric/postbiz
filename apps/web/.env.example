# Sans ces variables, l'app tourne en MODE DÉMO (données d'exemple, aucune connexion).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Affiche le bouton « Continuer avec Google » (à activer aussi dans Supabase > Authentication > Providers)
NEXT_PUBLIC_AUTH_GOOGLE=0
# URL publique du site (liens des emails de confirmation)
NEXT_PUBLIC_SITE_URL=http://localhost:3100
