# Sans ces variables, l'app tourne en MODE DÉMO (données d'exemple, aucune connexion).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Affiche le bouton « Continuer avec Google » (à activer aussi dans Supabase > Authentication > Providers)
NEXT_PUBLIC_AUTH_GOOGLE=0
# URL publique du site (liens des emails de confirmation) = domaine principal
NEXT_PUBLIC_SITE_URL=http://localhost:3100
# Domaines secondaires qui redirigent (308) vers le domaine principal ci-dessus, avec leur www., chemin conservé.
# Absent : getpostbiz.com, trypostiz.com, postizz.com, post-iz.com. Vide : aucun. Sans effet tant que le site est en local.
# Lues au build : à définir avant `next build`. Chaque domaine doit aussi pointer vers l'hébergement (DNS + certificat).
# SITE_ALIAS_DOMAINS=getpostbiz.com,trypostiz.com,postizz.com,post-iz.com

# --- Connexion des canaux par OAuth (côté serveur uniquement : jamais de préfixe NEXT_PUBLIC_) ---
# Même valeurs que dans le .env racine. NEXT_PUBLIC_SITE_URL doit être l'adresse publique exacte : elle sert
# d'adresse de retour OAuth et de contrôle d'origine du bouton « Connecter ».
SUPABASE_SERVICE_ROLE_KEY=
TOKEN_ENCRYPTION_KEY=
META_APP_ID=
META_APP_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
