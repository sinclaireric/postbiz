# Copiez ce fichier en .env (non versionné) et renseignez votre projet Supabase :
# Supabase → Project Settings → API.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clé « anon » (publique). Jamais la clé service_role dans une application mobile.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Adresse publique (HTTPS) de l'application web, sans « / » final : ouverte par l'écran « Ajouter un canal »
# pour connecter un canal (OAuth). Doit être la même que NEXT_PUBLIC_SITE_URL côté web.
EXPO_PUBLIC_WEB_URL=
