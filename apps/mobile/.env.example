# Copiez ce fichier en .env (non versionné) et renseignez votre projet Supabase :
# Supabase → Project Settings → API.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clé « anon » (publique). Jamais la clé service_role dans une application mobile.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optionnel : adresse de l'application web, proposée sur l'écran « Ajouter un canal ».
EXPO_PUBLIC_WEB_URL=
