    "buffer": "^6.0.3",
    "date-fns": "^4.1.0",
    "expo": "^58.0.17",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.9",
    "expo-haptics": "~58.0.7",
    "expo-file-system": "~58.0.10",
