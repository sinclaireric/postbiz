{
  "expo": {
    "name": "Postbiz",
    "slug": "postbiz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "postbiz",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.postbiz.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.postbiz.app",
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "backgroundColor": "#C6F432",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#F8F7F4",
          "dark": {
            "backgroundColor": "#F8F7F4"
          }
        }
      ],
      [
        "expo-system-ui",
        {
          "backgroundColor": "#F8F7F4"
        }
      ],
      [
        "expo-navigation-bar",
        {
          "barStyle": "dark-content"
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#2F4A00",
          "icon": "./assets/images/notification-icon.png"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Postbiz accède à vos photos pour les ajouter à votre médiathèque.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "expo-navigation-bar": {
        "barStyle": "dark-content",
        "style": "dark-content"
      },
      "eas": {
        "projectId": "de70579f-348f-470b-9989-feceaeb9a432"
      }
    },
    "owner": "sinclaireric60"
  }
}
