# --- Supabase (projet cloud : Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # worker et Edge Functions uniquement, jamais côté navigateur

# --- Chiffrement des tokens des réseaux (32 octets en base64 : openssl rand -base64 32) ---
TOKEN_ENCRYPTION_KEY=

# --- Connexion des canaux (OAuth) ---
# L'app web ET le worker lisent ces variables : renseignez-les aussi dans apps/web/.env.local (voir apps/web/.env.example).
# Un bouton « Connecter » reste désactivé tant que les variables de son réseau ne sont pas toutes renseignées.
# Adresse de retour à enregistrer chez chaque réseau : <NEXT_PUBLIC_SITE_URL>/api/oauth/callback/<meta|x|linkedin|google|tiktok>
# (voir docs/RESEAUX.md).

# --- Meta (Facebook, Instagram) ---
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=        # chaîne secrète choisie par vous, saisie aussi dans le tableau de bord Meta

# --- Autres réseaux ---
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_API_VERSION=             # facultatif, AAAAMM (défaut : voir apps/worker/src/providers/linkedin.ts)

# --- Worker (facultatif) ---
# WORKER_REFRESH_INTERVAL_MS=60000   # fréquence du rafraîchissement des jetons
